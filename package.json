{
  "name": "meongback-home",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "start": "node --env-file-if-exists=.env server/index.js",
    "assets": "node scripts/optimize-assets.mjs",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "check:production": "node --env-file-if-exists=.env scripts/check-production.mjs",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsc --noEmit -p . && node --test tests/*.test.js",
    "cloud:setup": "node --env-file=.env.cloud scripts/setup-supabase.mjs",
    "cloud:check": "node --env-file=.env.cloud scripts/check-cloud.mjs",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/functions": "^3.9.5",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "lucide": "^0.468.0",
    "pg": "^8.23.0",
    "pretendard": "^1.3.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/generator": "^8.0.0",
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@babel/types": "^8.0.4",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.55.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^7.1.3"
  },
  "engines": {
    "node": "24.x"
  }
}

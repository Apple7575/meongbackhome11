{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["icn1"],
  "functions": {"api/index.js": {"maxDuration": 60}},
  "rewrites": [{"source": "/api/:path*", "destination": "/api"}, {"source": "/d/:id", "destination": "/api"}, {"source": "/sitemap.xml", "destination": "/api"}],
  "headers": [
    {"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}, {"key": "X-Frame-Options", "value": "DENY"}]},
    {"source": "/sw.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
    {"source": "/index.html", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
  ],
  "crons": [{"path": "/api/maintenance", "schedule": "0 18 * * *"}]
}
